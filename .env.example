# Modbus Settings (first start only: become Bus 1 / Sensor 1, afterwards use the Settings tab)
MODBUS_PORT=COM11
MODBUS_SLAVE_ID=1
MODBUS_BAUDRATE=9600
MODBUS_BYTESIZE=8
MODBUS_PARITY=N
MODBUS_STOPBITS=1
MODBUS_TIMEOUT=1
MODBUS_FUNCTION_CODE=4
MODBUS_REGISTER_TEMP=1
MODBUS_REGISTER_HUMIDITY=2

# Database Settings
DATABASE_FILE=src/modbus_sensor_data.db

# Initial values only: used once on first start, afterwards change them in the Settings tab
# (listen address/port are set in the Settings tab only, default 0.0.0.0:8050)
DATA_RETENTION_DAYS=0
DEBUG_LOGGING=False
TIMEZONE=Europe/Amsterdam
DEFAULT_LANGUAGE=EN
